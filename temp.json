    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function checkLiveUrl(btn, url) {
            const icon = btn.querySelector('i');
            const originalIconClass = icon.className;
            icon.className = 'fas fa-spinner fa-spin me-1';
            btn.disabled = true;

            // 增加标记，防止重复点击
            btn.setAttribute('data-checking', 'true');

            fetch(`?action=check_url&check_url=${encodeURIComponent(url)}`)
                .then(response => response.json())
                .then(data => {
                    if (data.status) {
                        btn.classList.replace('btn-outline-secondary', 'btn-success');
                        btn.classList.replace('btn-danger', 'btn-success');
                        btn.innerHTML = `<i class="fas fa-check me-1"></i>有效(${data.code})`;
                    } else {
                        btn.classList.replace('btn-outline-secondary', 'btn-danger');
                        btn.classList.replace('btn-success', 'btn-danger');
                        btn.innerHTML = `<i class="fas fa-times me-1"></i>失效(${data.code})`;
                    }
                })
                .catch(err => {
                    btn.classList.replace('btn-outline-secondary', 'btn-warning');
                    btn.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>错误';
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.removeAttribute('data-checking');
                    if (!btn.classList.contains('btn-success') && !btn.classList.contains('btn-danger')) {
                        icon.className = originalIconClass;
                    }
                });
        }

        function checkAllLiveSources(mainBtn) {
            const liveButtons = document.querySelectorAll('button[onclick^="checkLiveUrl"]');
            if (liveButtons.length === 0) {
                alert('未找到可检测的直播源地址');
                return;
            }

            const originalHtml = mainBtn.innerHTML;
            mainBtn.disabled = true;
            mainBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>正在批量检测...';

            let completed = 0;
            liveButtons.forEach(btn => {
                // 触发点击事件或直接调用函数
                if (!btn.hasAttribute('data-checking')) {
                    btn.click();
                }
            });

            // 简单的轮询检查是否全部完成
            const timer = setInterval(() => {
                const checking = document.querySelectorAll('button[data-checking="true"]');
                if (checking.length === 0) {
                    clearInterval(timer);
                    mainBtn.disabled = false;
                    mainBtn.innerHTML = '<i class="fas fa-check-double me-1"></i>检测完成';
                    setTimeout(() => {
                        mainBtn.innerHTML = originalHtml;
                    }, 3000);
                }
            }, 1000);
        }

        function copyDebug(elementId) {
            // 根据 ID 获取对应的隐藏完整数据 textarea
            const fullId = elementId === 'debug_raw_content' ? 'debug_raw_full' : 'debug_cleaned_full';
            const textArea = document.getElementById(fullId);

            textArea.style.display = 'block';
            textArea.select();
            try {
                document.execCommand('copy');
                const btn = event.target;
                const originalText = btn.innerText;
                btn.innerText = '已复制';
                btn.classList.replace('btn-dark', 'btn-success');
                setTimeout(() => {
                    btn.innerText = originalText;
                    btn.classList.replace('btn-success', 'btn-dark');
                }, 2000);
            } catch (err) {
                alert('复制失败，请手动选择复制');
            }
            textArea.style.display = 'none';
        }
    </script>
</body>

</html>